# Copy to .env and fill in
# Free key: https://aistudio.google.com/apikey  (leave empty to run fully offline with the extractive NLP engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# auto = Sentence-Transformers + FAISS (falls back automatically) | tfidf = lightweight, no model download
EMBEDDINGS=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
